{
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/post/:slug", "destination": "/api/post?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
